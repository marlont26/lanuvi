# Local database (SQLite file). For Postgres set:
# DATABASE_URL="postgresql://user:password@localhost:5432/lanuvi?schema=public"
# and change the datasource provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Number that receives WhatsApp order confirmations (international format, digits only).
NEXT_PUBLIC_WHATSAPP_NUMBER="573001234567"

# Online payments run in test mode only; no real gateway keys are required.
NEXT_PUBLIC_ONLINE_PAYMENTS_ENABLED="true"
