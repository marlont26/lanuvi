# PostgreSQL connection (Supabase in production, any local Postgres in development).
# Supabase → Project Settings → Database → Connection string:
#   DATABASE_URL: pooler (puerto 6543) con ?pgbouncer=true&connection_limit=1
#   DIRECT_URL:   conexión directa (puerto 5432), la usa `prisma db push`
DATABASE_URL="postgresql://postgres:password@localhost:5432/lanuvi?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/lanuvi?schema=public"

# Datos de la transferencia manual que ve el cliente en el checkout.
NEXT_PUBLIC_NEQUI_PHONE="300 123 4567"
NEXT_PUBLIC_NEQUI_HOLDER="Lanuvi SAS"

# Number that receives WhatsApp order confirmations (international format, digits only).
NEXT_PUBLIC_WHATSAPP_NUMBER="573001234567"

# Comprobantes de pago. Sin estas variables se guardan en public/uploads (solo local);
# con ellas se suben al bucket público de Supabase Storage.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PROOF_BUCKET="comprobantes"

# Password for /admin. Set your own; while empty the panel and its APIs stay locked.
# e.g. openssl rand -base64 18
ADMIN_PASSWORD="marlon"
