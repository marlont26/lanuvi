// Lanuvi store schema.
// Runs on PostgreSQL (Supabase in production, any local Postgres for development).
// `gallery` and `nutrition` stay JSON strings so the data shape is unchanged.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase pools connections on 6543; migrations/db push need the direct 5432 URL.
  directUrl = env("DIRECT_URL")
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String
  description String
  category    String
  imageUrl    String
  gallery     String   @default("[]")
  nutrition   String   @default("[]")
  ingredients String   @default("")
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants   ProductVariant[]
  orderItems OrderItem[]

  @@index([category])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  flavor    String
  size      String
  price     Int
  stock     Int     @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, flavor, size])
}

model Order {
  id            String   @id @default(cuid())
  code          String   @unique
  /// Secret shared only with the buyer; required to open the confirmation page.
  token         String   @unique @default(cuid())
  customerName  String
  phone         String
  email         String   @default("")
  address       String
  city          String
  notes         String   @default("")
  paymentMethod String
  status        String   @default("PENDING_PAYMENT")
  /// Nequi transfer reference typed by the buyer (manual payment).
  paymentReference String @default("")
  /// Public URL of the uploaded transfer receipt, when the buyer attached one.
  paymentProofUrl  String @default("")
  subtotal      Int
  shipping      Int
  total         Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items OrderItem[]

  @@index([status])
}

model OrderItem {
  id           String @id @default(cuid())
  orderId      String
  productId    String
  variantId    String
  name         String
  variantLabel String
  unitPrice    Int
  quantity     Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])
}
